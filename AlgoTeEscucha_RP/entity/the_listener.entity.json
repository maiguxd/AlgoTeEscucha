{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "listener:the_listener",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/entity/terror_skeleton"
      },
      "geometry": {
        "default": "geometry.terror_skeleton"
      },
      "animations": {
        "idle": "animation.terror_skeleton.idle",
        "walk": "animation.terror_skeleton.walk",
        "attack": "animation.terror_skeleton.attack"
      },
      "scripts": {
        "animate": [
          { "attack": "query.mark_variant == 4" },
          { "walk": "query.mark_variant == 2" },
          { "idle": "query.mark_variant != 2 && query.mark_variant != 4" }
        ]
      },
      "render_controllers": ["controller.render.the_listener"],
      "spawn_egg": {
        "base_color": "#1a1e22",
        "overlay_color": "#3a4248"
      }
    }
  }
}
