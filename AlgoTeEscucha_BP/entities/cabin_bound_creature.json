{
  "format_version": "1.20.80",
  "minecraft:entity": {
    "description": {
      "identifier": "terror:cabin_bound_creature",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false,
      "properties": {
        "terror:releasing": {
          "type": "bool",
          "default": false,
          "client_sync": true
        }
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": [
          "terror_cabin_prop"
        ]
      },
      "minecraft:persistent": {},
      "minecraft:physics": {
        "has_gravity": false,
        "has_collision": false
      },
      "minecraft:collision_box": {
        "width": 0.7,
        "height": 3.5
      },
      "minecraft:pushable": {
        "is_pushable": false,
        "is_pushable_by_piston": false
      },
      "minecraft:health": {
        "value": 20,
        "max": 20
      },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "cause": "all",
            "deals_damage": false
          }
        ]
      },
      "minecraft:knockback_resistance": {
        "value": 1
      },
      "minecraft:scale": {
        "value": 0.88
      }
    },
    "component_groups": {
      "terror:vanish": {
        "minecraft:instant_despawn": {}
      },
      "terror:release_timer": {
        "minecraft:timer": {
          "time": 3.4,
          "looping": false,
          "time_down_event": {
            "event": "terror:release_finished",
            "target": "self"
          }
        }
      }
    },
    "events": {
      "terror:release": {
        "sequence": [
          {
            "filters": {
              "test": "bool_property",
              "domain": "terror:releasing",
              "value": false
            },
            "set_property": {
              "terror:releasing": true
            },
            "add": {
              "component_groups": [
                "terror:release_timer"
              ]
            }
          }
        ]
      },
      "terror:release_finished": {
        "remove": {
          "component_groups": [
            "terror:release_timer"
          ]
        },
        "queue_command": {
          "command": "execute at @s run function terror_cabin/finish_release",
          "target": "self"
        }
      },
      "terror:vanish_now": {
        "add": {
          "component_groups": [
            "terror:vanish"
          ]
        }
      },
      "terror:reset_bound": {
        "set_property": {
          "terror:releasing": false
        },
        "remove": {
          "component_groups": [
            "terror:release_timer"
          ]
        }
      }
    }
  }
}